# eza
export EZA_COLORS="di=96:fi=3;37:ln=95"
alias ls='eza --grid  --icons --git --group-directories-first --sort=type'
alias lsa='ls -a'
alias lst='eza --tree --level=2 --icons --git --group-directories-first --sort=type'

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias conf='cd ~/.config'
alias dot='cd ~/dotfiles'
alias ~='cd ~'

#Activate uv venv, Must be in a directory where .venv exists
alias venv="source .venv/bin/activate"

# Tools
alias oc='opencode'
alias vim='nvim'
alias t='tmux attach || tmux new -s "NEW SESSION"'
alias tnew='tmux new -s'

# Git
alias gcm='git commit -m' 
