{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "lucent-orng"
  },
  "keybinds": {
    "app.exit": "ctrl+e",
    "help.show": "ctrl+h",
    "session.list": "ctrl+s",
    "session.rename": "ctrl+r",
    "variant.list": "ctrl+v"
  },
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": false,
    "volume": 0.4
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true
}
